        416,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://yttotext.com/api/v1/transcripts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.apiKey }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "=n8n-{{ $execution.id }}-{{ $json.videoId }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"ids\": [\"{{ $json.videoId }}\"],\n  \"language\": \"{{ $json.language }}\"\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-create-job",
      "name": "Create Transcript Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        480
      ]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "wait-poll",
      "name": "Wait 5s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        864,
        480
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://yttotext.com{{ $('Create Transcript Request').item.json.statusUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Set Video & API Key').item.json.apiKey }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-poll-status",
      "name": "Poll Transcript Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1088,
        480
      ]
    },
